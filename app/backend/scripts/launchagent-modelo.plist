<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mantem o llama-server de pe no Mac, escutando no IP da tailnet, para o Cipher
  publicado no Sentinel alcancar a inferencia daqui.

  Resolve a armadilha de sempre: o llama-server e um processo SEPARADO do Node e
  morre quando o shell fecha. Sem isto, fechar o terminal derruba o chat
  publicado, e o sintoma no celular e um 503 sem causa aparente.

  ⚠️ CUSTO DE MEMORIA: este Mac tem 8 GB e o modelo de 2 GB fica residente
  enquanto o agent estiver carregado (medido: ~900 MB de RSS logo apos subir, mais
  o KV cache conforme o uso). Carregue de proposito, nao por padrao.

  Instalar:
    cp scripts/launchagent-modelo.plist ~/Library/LaunchAgents/tech.trajano.cipher-modelo.plist
    launchctl load  ~/Library/LaunchAgents/tech.trajano.cipher-modelo.plist

  Conferir:
    launchctl list | grep cipher-modelo
    tail -f /tmp/cipher-modelo.launchd.log

  Remover (volta ao comportamento manual de `npm run modelo`):
    launchctl unload ~/Library/LaunchAgents/tech.trajano.cipher-modelo.plist
    rm ~/Library/LaunchAgents/tech.trajano.cipher-modelo.plist

  ⚠️ O caminho do WorkingDirectory e absoluto e cravado: LaunchAgent nao expande
  ~ nem le o shell. Mudou a pasta do projeto, edite aqui tambem.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>tech.trajano.cipher-modelo</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/mathtrajan/Dev/Cipher/app/backend/scripts/modelo-local.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/mathtrajan/Dev/Cipher/app/backend</string>

	<key>EnvironmentVariables</key>
	<dict>
		<!-- Escuta no IP da tailnet em vez do loopback. O script recusa subir se o
		     Tailscale estiver fora do ar, com motivo no log, em vez de falhar com
		     EADDRNOTAVAIL. -->
		<key>CIPHER_MODELO_NA_TAILNET</key>
		<string>1</string>
		<!-- O brew nao esta no PATH de um LaunchAgent: ele nao le o ~/.zprofile. -->
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<!-- Sobe de novo se o processo morrer, mas NAO insiste quando ele sai bem.
	     Importante: sem SuccessfulExit=false o launchd entraria em loop quando o
	     script recusa subir (Tailscale desligado, porta ocupada), que sao saidas
	     deliberadas. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<!-- Espaca as tentativas: sem isto o launchd tenta de 1 em 1 segundo e cada
	     tentativa carrega 2 GB de GGUF do disco. -->
	<key>ThrottleInterval</key>
	<integer>30</integer>

	<key>StandardOutPath</key>
	<string>/tmp/cipher-modelo.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/cipher-modelo.launchd.log</string>

	<!-- Prioridade baixa de I/O e CPU: a inferencia nao deve atrapalhar o que
	     estiver sendo usado em primeiro plano no Mac. -->
	<key>ProcessType</key>
	<string>Adaptive</string>
	<key>LowPriorityIO</key>
	<true/>
</dict>
</plist>
